# Rehabot — environment configuration (placeholders only, no real values)

# ---------------------------------------------------------------------------
# Frontend (Vite) — copy to .env.local and fill in real values
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets — set with: supabase secrets set NAME=VALUE
# (never commit real values)
# ---------------------------------------------------------------------------
# Existing
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_SIGNATURE_ENFORCE=
META_TEMPLATE_HEADER_IMAGE_URL=
ANTHROPIC_API_KEY=

# Textify Africa (Continuity Engine)
TEXTIFY_API_KEY=
# NOTE: the API base is /api/v1 (not /v1)
TEXTIFY_BASE_URL=https://portal.textify.africa/api/v1
# Must be an APPROVED Textify sender name. "REHABOT" is not approved yet;
# use an approved one (e.g. "Textify") or request "REHABOT" in the portal.
TEXTIFY_DEFAULT_SENDER=Textify
TEXTIFY_WEBHOOK_SECRET=
TEXTIFY_WEBHOOK_ENFORCE=false

# Fallback threshold (minutes) before a no-response SMS nudge is sent
FALLBACK_AFTER_MINUTES=120
